PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<prod-username>:<prod-password>@<prod-cluster>.mongodb.net/skillbridge?retryWrites=true&w=majority
JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))">
JWT_EXPIRES_IN=7d
CLIENT_URL=https://your-frontend-domain.vercel.app